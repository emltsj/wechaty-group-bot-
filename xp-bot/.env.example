# ============================================================
# 定时微信群发机器人（XP Hook 版）配置示例
# Scheduled WeChat broadcaster (XP hook edition) - configuration example
#
# 用法 / Usage:
#   复制本文件为 .env / Copy this file to .env
#   需要多分店时继续复制为 env2、env3、env4
#   For multiple stores, copy again as env2 / env3 / env4
# ============================================================

# 主人的微信名或备注名 / Owner WeChat name or remark
MASTER_NAME='YourWechatName'

# 固定群发群列表，英文逗号分隔 / Fixed group list, comma separated
ROOM_LIST='Group A,Group B'

# ========== 常规群发：每天 12:45 起每 25 分钟（±3 分钟） ==========
# Daily: every 25 min from 12:45 (random ±3 min)
SCHEDULE_MESSAGE_DAILY='大家下午好！今天正常营业，欢迎下单 ☀️'
SCHEDULE_IMAGE_DAILY=''

# ========== 周一~周五特殊群发：前一天 19:30 起预热，当天早上继续提醒 ==========
# Mon-Fri special: warm-up from 19:30 the evening before, reminders the next morning
SCHEDULE_MESSAGE_MON='周一限定菜品，现在可以预定啦！'
SCHEDULE_IMAGE_MON='images/monday.jpg'

SCHEDULE_MESSAGE_TUE='周二有新品上架，数量有限，先到先得！'
SCHEDULE_IMAGE_TUE='images/tuesday.jpg'

SCHEDULE_MESSAGE_WED='周三特供，欢迎提前预定！'
SCHEDULE_IMAGE_WED='images/wednesday.jpg'

SCHEDULE_MESSAGE_THU='周四限定款，预购从速！'
SCHEDULE_IMAGE_THU='images/thursday.jpg'

SCHEDULE_MESSAGE_FRI='周五上新，抓紧下单！'
SCHEDULE_IMAGE_FRI='images/friday.jpg'

# ============================================================
# 文案写法 / Message formats（三种都支持 / all three work）
#   1) 跨多行 / multi-line:  SCHEDULE_MESSAGE_MON='第一行
#                            第二行'
#   2) \n 转义 / escapes:    SCHEDULE_MESSAGE_MON='第一行\n第二行'
#   3) 单行无引号 / no quote: SCHEDULE_MESSAGE_MON=今天正常营业
# ============================================================

# 图片路径：相对项目根目录或绝对路径，留空则只发文字
# Image path: relative to project root or absolute; empty = text only
