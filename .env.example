# ============================================================
# 定时微信群发机器人 - 配置示例 / Configuration example
#
# 使用方法 / Usage:
#   1. 复制本文件为 .env      Copy this file to .env
#   2. 按需修改群名、文案、图片路径 / Edit groups, messages, image paths
#   3. 保存后程序自动热更新    Changes are hot-reloaded automatically
#
# 需要多个分店时，再复制为 env2、env3、env4
# For multiple stores, copy again as env2 / env3 / env4
# ============================================================

# 主人的微信名或备注名：主人在哪个群发言，该群会自动加入群发列表
# Owner's WeChat name/remark: a group where the owner speaks is added automatically
MASTER_NAME='YourWechatName'

# 固定群发群列表，英文逗号分隔（留空则只依赖自动/手动添加）
# Fixed target groups, comma separated (empty = rely on auto/manual add)
ROOM_LIST='Group A,Group B'

# ========== 常规群发 / Daily broadcast ==========
# 每天 12:45 起每 25 分钟一次，随机 ±3 分钟，最后一条 16:55（不越过 17:00 截单）
# Every 25 min from 12:45 daily, random ±3 min, last one 16:55 (before 17:00 cut-off)
SCHEDULE_MESSAGE_DAILY='大家下午好！今天正常营业，欢迎下单 ☀️'
# 图片路径，留空则只发文字 / Image path, leave empty to send text only
SCHEDULE_IMAGE_DAILY=''

# ========== 周一特殊群发 / Monday special ==========
# 前一天 19:30~23:30 每 30 分钟预热，当天 00:00/00:30/01:00 及 07:00~10:45 每 25 分钟提醒
# Warm-up 19:30-23:30 the night before; reminders at 00:00/00:30/01:00 and 07:00-10:45
SCHEDULE_MESSAGE_MON='周一限定菜品，现在可以预定啦！'
SCHEDULE_IMAGE_MON='images/monday.jpg'

# ========== 周二 / Tuesday ==========
SCHEDULE_MESSAGE_TUE='周二有新品上架，数量有限，先到先得！'
SCHEDULE_IMAGE_TUE='images/tuesday.jpg'

# ========== 周三 / Wednesday ==========
SCHEDULE_MESSAGE_WED='周三特供，欢迎提前预定！'
SCHEDULE_IMAGE_WED='images/wednesday.jpg'

# ========== 周四 / Thursday ==========
SCHEDULE_MESSAGE_THU='周四限定款，预购从速！'
SCHEDULE_IMAGE_THU='images/thursday.jpg'

# ========== 周五 / Friday ==========
SCHEDULE_MESSAGE_FRI='周五上新，抓紧下单！'
SCHEDULE_IMAGE_FRI='images/friday.jpg'

# ============================================================
# 文案写法 / Message formats（三种都支持 / all three work）
# ============================================================
# 1) 跨多行（推荐，所见即所得）/ multi-line (recommended)
#    SCHEDULE_MESSAGE_MON='第一行
#    第二行'
# 2) 单行 + \n 转义 / single line with \n escapes
#    SCHEDULE_MESSAGE_MON='第一行\n第二行'
# 3) 单行不写引号 / single line without quotes
#    SCHEDULE_MESSAGE_MON=今天正常营业
#
# 注意 / Note:
#   - 多行写法必须用引号包裹，结束引号要落在最后一行行尾
#   - Multi-line values must be quoted, closing quote at the end of the last line
#   - \n 转义只对 SCHEDULE_MESSAGE_* 生效，图片路径不受影响
#   - \n decoding only applies to SCHEDULE_MESSAGE_*, image paths are untouched

# ============================================================
# 图片路径 / Image paths
# ============================================================
# 相对项目根目录或绝对路径；不需要图片留空
# Relative to project root or absolute; leave empty for text-only
# 支持 / Supported: .jpg .jpeg .png .gif .webp
